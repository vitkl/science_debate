{
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "teammateMode": "in-process",
    "permissions": {
        "allow": [
            "Write(debate_events/**)",
            "Edit(debate_events/**)",
            "Bash(bash scripts/helper_scripts/run_python_cmd.sh debate/scripts/*)",
            "Bash(bash scripts/helper_scripts/run_conda_bash.sh -- pip install*)",
            "Bash(mkdir -p debate_events/*)",
            "Bash(mkdir -p papers_cache/*)",
            "Bash(ln -s debate/* .claude/*)",
            "Read(~/.claude/settings.json)",
            "Read(~/.claude/settings.local.json)",
            "Read(~/.claude/CLAUDE.md)",
            "Read(~/.claude/skills/**)",
            "Read(~/.claude/agents/**)",
            "Read(~/.claude/commands/**)",
            "Read(~/.claude/output-styles/**)",
            "Read(~/.claude/hooks/**)",
            "Read(~/.claude/keybindings.json)"
        ],
        "ask": [
            "Bash(rm *)",
            "Bash(mv *)",
            "Bash(chmod *)",
            "Bash(chown *)",
            "Bash(chgrp *)",
            "Bash(curl *)",
            "Bash(wget *)",
            "Bash(scp *)",
            "Bash(rsync *)",
            "Bash(ssh *)",
            "Bash(sftp *)",
            "Bash(ftp *)",
            "Bash(nc *)",
            "Bash(netcat *)",
            "Bash(telnet *)",
            "Bash(brew install *)",
            "Bash(brew uninstall *)",
            "Bash(apt *)",
            "Bash(apt-get *)",
            "Bash(yum *)",
            "Bash(dnf *)",
            "Bash(npm install -g *)",
            "Bash(pip install *)",
            "Bash(pip uninstall *)",
            "Bash(killall *)",
            "Bash(eval *)",
            "Bash(exec *)",
            "Bash(systemctl *)",
            "Bash(launchctl *)",
            "Bash(crontab *)",
            "Bash(git push *)",
            "Bash(git commit *)",
            "Bash(git config *)",
            "Bash(git reset --hard*)",
            "Bash(git checkout .*)",
            "Bash(git clean -*)",
            "Bash(git rebase *)",
            "Read(~/.claude/projects/**)",
            "Read(~/.claude/plans/**)"
        ],
        "deny": [
            "Bash(sudo *)",
            "Bash(su *)",
            "Bash(doas *)",
            "Bash(rm -rf /*)",
            "Bash(rm -rf ~/*)",
            "Bash(rm -rf $HOME/*)",
            "Bash(rm -rf /)",
            "Bash(dd *)",
            "Bash(mkfs *)",
            "Bash(fdisk *)",
            "Bash(diskutil *)",
            "Bash(parted *)",
            "Bash(git filter-branch *)",
            "Bash(git filter-repo *)",
            "Write(~/.ssh/**)",
            "Edit(~/.ssh/**)",
            "Read(~/.ssh/**)",
            "Write(~/.aws/**)",
            "Edit(~/.aws/**)",
            "Read(~/.aws/**)",
            "Write(~/.gnupg/**)",
            "Edit(~/.gnupg/**)",
            "Read(~/.gnupg/**)",
            "Write(~/.docker/**)",
            "Edit(~/.docker/**)",
            "Write(~/.kube/**)",
            "Edit(~/.kube/**)",
            "Read(~/.netrc)",
            "Read(~/.npmrc)",
            "Write(//etc/**)",
            "Edit(//etc/**)",
            "Write(//System/**)",
            "Edit(//System/**)",
            "Write(//Library/**)",
            "Edit(//Library/**)",
            "Write(//usr/**)",
            "Edit(//usr/**)",
            "Write(//bin/**)",
            "Edit(//bin/**)",
            "Write(//sbin/**)",
            "Edit(//sbin/**)",
            "Write(//var/**)",
            "Edit(//var/**)",
            "Read(//etc/shadow)",
            "Read(//etc/sudoers)"
        ]
    }
}
